        </mxCell>
        <!-- 8 -->
        <mxCell id="m8" value="8. order object { id, amount, currency }" style="html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="790" y="365" as="sourcePoint" /><mxPoint x="550" y="365" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 9 -->
        <mxCell id="m9" value="9. { orderId, key, amount } → open Checkout" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="550" y="400" as="sourcePoint" /><mxPoint x="310" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 10 -->
        <mxCell id="m10" value="10. Razorpay Checkout widget opens" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="435" as="sourcePoint" /><mxPoint x="790" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 11 -->
        <mxCell id="m11" value="11. enters card/UPI details, pays" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="470" as="sourcePoint" /><mxPoint x="790" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 12 -->
        <mxCell id="m12" value="12. handler(response) { payment_id, order_id, signature }" style="html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="790" y="505" as="sourcePoint" /><mxPoint x="310" y="505" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 13 -->
        <mxCell id="m13" value="13. POST /payments/verify { payment_id, order_id, signature }" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="540" as="sourcePoint" /><mxPoint x="550" y="540" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 14 (parallel async webhook) -->
        <mxCell id="m14" value="14. (async, in parallel) POST /webhooks/razorpay — signature-verified, idempotent" style="html=1;endArrow=block;fontSize=10;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="790" y="580" as="sourcePoint" /><mxPoint x="550" y="580" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 15 -->
        <mxCell id="m15" value="15. HMAC-SHA256 signature check passes" style="html=1;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="550" y="615" as="sourcePoint" /><mxPoint x="620" y="615" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 16 -->
        <mxCell id="m16" value="16. Booking.status → 'confirmed' (idempotent update)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="550" y="650" as="sourcePoint" /><mxPoint x="1010" y="650" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 17 -->
        <mxCell id="m17" value="17. mailer.sendBookingConfirmation()" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="550" y="685" as="sourcePoint" /><mxPoint x="1210" y="685" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 18 -->
        <mxCell id="m18" value="18. confirmation email delivered" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="720" as="sourcePoint" /><mxPoint x="110" y="720" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 19 -->
        <mxCell id="m19" value="19. 200 { verified: true }" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="550" y="755" as="sourcePoint" /><mxPoint x="310" y="755" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- 20 -->
        <mxCell id="m20" value="20. shows booking confirmation screen" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="790" as="sourcePoint" /><mxPoint x="110" y="790" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="legend" value="Solid arrow = request/call  ·  Dashed arrow = response/return  ·  Red = independent async webhook path (Razorpay → server), which is why verification is idempotent" style="text;html=1;align=center;fontSize=11;fontStyle=2;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="840" width="1000" height="40" as="geometry" />
