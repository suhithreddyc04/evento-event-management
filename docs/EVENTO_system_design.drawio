          <mxGeometry x="500" y="700" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="m_booking" value="Booking&#10;— event: ObjectId→Event&#10;— user: ObjectId→User&#10;— name, email, phone, address, date&#10;— details: Mixed (category answers)&#10;— status: confirmed|waitlisted|pending_payment&#10;— advanceAmount, razorpayOrderId/PaymentId&#10;— finalAmount, finalPaymentStatus&#10;— finalRazorpayOrderId/PaymentId&#10;— reminderSent&#10;— UNIQUE INDEX (event, user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
