        <mxCell id="f6" value="6a. POST /payments/verify&#10;(client-side confirm, signature check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
