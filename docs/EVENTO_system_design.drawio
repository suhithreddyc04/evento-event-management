          <mxGeometry x="60" y="660" width="1580" height="300" as="geometry" />
        </mxCell>

        <mxCell id="m_user" value="log_reg_form (User)&#10;— name, email, password&#10;— googleId, avatarUrl&#10;— isAdmin: Boolean&#10;— role: 'client' | 'manager'&#10;— favorites: [ObjectId→Event]&#10;— resetPasswordToken/Expires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
