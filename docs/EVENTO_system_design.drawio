        </mxCell>

        <mxCell id="r_auth" value="auth.routes.js&#10;POST /register, /login&#10;POST /auth/google&#10;POST /forgot-password&#10;POST /reset-password/:token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" vertex="1" parent="1">
